NODE_ENV=development
LOG_LEVEL=info
PORT=8080
HOST=0.0.0.0
API_PREFIX=/api/v1
CLIENT_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/querydocs?schema=public
JWT_SECRET=change-this-development-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
GEMINI_API_KEY=your-gemini-api-key-or-any-other-embedding-service-api-key